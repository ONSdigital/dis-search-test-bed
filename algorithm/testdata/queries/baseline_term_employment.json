                }
              },
              "weight": 30
            },
            {
              "filter": {
                "term": {
                  "type": "timeseries"
                }
              },
              "weight": 10
            }
          ],
          "query": {
            "dis_max": {
              "queries": [
                {
                  "bool": {
                    "should": [
                      {
                        "match": {
                          "title.title_no_dates": {
                            "boost": 10,
                            "minimum_should_match": "1\u003c-2 3\u003c80% 5\u003c60%",
                            "query": "employment"
