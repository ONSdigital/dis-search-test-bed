{
  "_source": {
    "excludes": [
      "downloads.content",
      "downloads*",
      "pageData"
    ],
    "includes": []
  },
  "query": {
    "bool": {
      "filter": [
        {
          "bool": {
            "must": [
              {
                "bool": {
                  "should": []
                }
              },
              {
                "bool": {
                  "should": [
                    {
                      "range": {
